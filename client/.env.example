# Base URL for Backend API
VITE_API_URL=https://meesho-website.onrender.com/api

# Automatic Background Health Ping (Runs every 5 minutes while website tab is open)
# Set to 'true' to enable or 'false' to disable
VITE_ENABLE_HEALTH_PING=true

# Health Ping Interval in milliseconds (Default: 300000 = 5 minutes)
VITE_HEALTH_PING_INTERVAL_MS=300000
